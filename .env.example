# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — never commit real keys.
#
# Find these in the Supabase dashboard:
#   Project Settings -> Data API   (project URL / project ID)
#   Project Settings -> API Keys   (publishable + secret keys)

# ---------------------------------------------------------------------------
# Server-side only. Never expose these to the browser.
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# Bypasses RLS — treat as a password. Used by src/integrations/supabase/client.server.ts
# for the public booking flow (unauthenticated clients booking appointments).
# Accepts either the new `sb_secret_...` format or a legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Exposed to the browser via Vite. Only ever put publishable (RLS-protected)
# values here — anything prefixed VITE_ ships in the client bundle.
# ---------------------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Payments (Section 9). Server-side only.
# ---------------------------------------------------------------------------
# Which adapter is live. "mock" drives a local test checkout page instead of a
# real gateway. Set to "dibsy" once that adapter exists and sandbox creds are in.
PAYMENT_PROVIDER="mock"

# Shared secret the mock checkout page signs its webhook payloads with, and the
# webhook endpoint verifies against. Real HMAC — not a bypass. Replace with the
# provider's real signing secret when swapping providers.
MOCK_PAYMENT_WEBHOOK_SECRET="mock_whsec_replace_me"

# Public base URL, used to build checkout + return URLs.
APP_BASE_URL="http://localhost:8080"

# ---------------------------------------------------------------------------
# WhatsApp / Twilio (Section 10). Server-side only — NEVER VITE_-prefixed.
# TWILIO_AUTH_TOKEN is account-level: exposing it in the browser bundle would
# let anyone send messages as this account.
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER="twilio"
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# Sandbox sender is whatsapp:+14155238886. Replace with your own approved
# WhatsApp sender once the business is registered with Meta.
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Shared secret guarding scheduled-job endpoints (reminder sweep). The endpoint
# triggers outbound messaging, so it must not be openly callable.
JOBS_SECRET="replace_me"
